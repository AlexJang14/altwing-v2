
/* =========================================================
   WINGMATCH — FINAL READABILITY PASS
   WingMatch should be easier to read than the rest
   of the site because students must make decisions here.
   ========================================================= */

.wingmatch-shell {
  --wm-white: #f8faff;
  --wm-copy: rgba(239, 243, 252, .80);
  --wm-muted: rgba(222, 230, 246, .68);
  --wm-blue: #82a9ff;
  --wm-yellow: #ffc857;
}


/* =========================================================
   MAIN QUESTION
   ========================================================= */

.wingmatch-shell h1 {
  color: var(--wm-white) !important;

  font-size:
    clamp(
      38px,
      4vw,
      58px
    ) !important;

  line-height: 1.08 !important;
}


.wingmatch-shell h2 {
  color: var(--wm-white) !important;

  font-size:
    clamp(
      28px,
      3vw,
      42px
    ) !important;

  line-height: 1.15 !important;
}


/* =========================================================
   ALL CHOICE / OPTION CARDS
   ========================================================= */

.wingmatch-shell
button[class*="option"],

.wingmatch-shell
button[class*="choice"],

.wingmatch-shell
[class*="option-card"],

.wingmatch-shell
[class*="choice-card"] {
  text-align: left;
}


/* OPTION 1 / OPTION 2 / OPTION 3 */

.wingmatch-shell
button[class*="option"] small,

.wingmatch-shell
button[class*="choice"] small,

.wingmatch-shell
[class*="option-card"] small,

.wingmatch-shell
[class*="choice-card"] small {
  color: var(--wm-blue) !important;

  opacity: 1 !important;

  font-size: 12px !important;
  font-weight: 850 !important;

  letter-spacing: .08em !important;
}


/* BIG OPTION TITLE */

.wingmatch-shell
button[class*="option"] h3,

.wingmatch-shell
button[class*="choice"] h3,

.wingmatch-shell
button[class*="option"] strong,

.wingmatch-shell
button[class*="choice"] strong,

.wingmatch-shell
[class*="option-card"] h3,

.wingmatch-shell
[class*="choice-card"] h3,

.wingmatch-shell
[class*="option-card"] strong,

.wingmatch-shell
[class*="choice-card"] strong {
  color: var(--wm-white) !important;

  opacity: 1 !important;

  font-size:
    clamp(
      22px,
      1.8vw,
      29px
    ) !important;

  line-height: 1.28 !important;
}


/* DESCRIPTION UNDER EACH CHOICE */

.wingmatch-shell
button[class*="option"] p,

.wingmatch-shell
button[class*="choice"] p,

.wingmatch-shell
[class*="option-card"] p,

.wingmatch-shell
[class*="choice-card"] p {
  color: var(--wm-copy) !important;

  opacity: 1 !important;

  font-size:
    clamp(
      16px,
      1.2vw,
      18px
    ) !important;

  font-weight: 500 !important;

  line-height: 1.6 !important;
}


/* CHOOSE → */

.wingmatch-shell
button[class*="option"]
[class*="choose"],

.wingmatch-shell
button[class*="choice"]
[class*="choose"],

.wingmatch-shell
[class*="option-card"]
[class*="choose"],

.wingmatch-shell
[class*="choice-card"]
[class*="choose"] {
  color: var(--wm-yellow) !important;

  opacity: 1 !important;

  font-size: 13px !important;
  font-weight: 900 !important;

  letter-spacing: .07em !important;
}


/* =========================================================
   FALLBACK FOR THE CURRENT V5 CARDS
   Even if their class names do not contain option/choice.
   ========================================================= */

.wingmatch-shell
button p {
  color: var(--wm-copy) !important;

  opacity: 1 !important;

  font-size: 16px !important;

  line-height: 1.58 !important;
}


.wingmatch-shell
button strong {
  color: var(--wm-white) !important;

  opacity: 1 !important;

  font-size: 22px !important;

  line-height: 1.3 !important;
}


.wingmatch-shell
button small {
  opacity: 1 !important;

  font-size: 11px !important;
}


/* =========================================================
   GENERAL EXPLANATION / INSTRUCTION TEXT
   ========================================================= */

.wingmatch-shell
:where(
  [class*="hint"],
  [class*="instruction"],
  [class*="description"],
  [class*="helper"],
  [class*="explanation"]
) {
  color: var(--wm-copy) !important;

  opacity: 1 !important;

  font-size: 16px !important;

  line-height: 1.6 !important;
}


/* =========================================================
   MISSION STATUS / HUD
   No more 4–8px labels.
   ========================================================= */

.wingmatch-shell
:where(
  small,
  [class*="label"],
  [class*="status"],
  [class*="meta"],
  [class*="metric"],
  [class*="track"]
) {
  opacity: .95 !important;
}


.wingmatch-shell small {
  font-size: 11px !important;
  line-height: 1.4 !important;
}


.wingmatch-shell
[class*="metric"] span,

.wingmatch-shell
[class*="status"] span,

.wingmatch-shell
[class*="track"] span {
  font-size: 11px !important;
}


/* =========================================================
   BOTTOM DISCLAIMER
   ========================================================= */

.wingmatch-shell
:where(
  [class*="disclaimer"],
  [class*="footer"],
  [class*="note"]
) {
  color: var(--wm-muted) !important;

  opacity: 1 !important;

  font-size: 12px !important;

  line-height: 1.5 !important;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 720px) {

  .wingmatch-shell
  button[class*="option"] h3,

  .wingmatch-shell
  button[class*="choice"] h3,

  .wingmatch-shell
  button[class*="option"] strong,

  .wingmatch-shell
  button[class*="choice"] strong {
    font-size: 21px !important;
  }


  .wingmatch-shell
  button[class*="option"] p,

  .wingmatch-shell
  button[class*="choice"] p {
    font-size: 15px !important;
  }
}


/* =========================================================
   WINGMATCH V5 — ACTUAL CHOICE CARDS
   Exact selector used by current WingMatch.
   ========================================================= */

.wm-choice-card {
  min-height: 220px !important;
  padding: 24px 22px !important;
}


/* OPTION 1 / OPTION 2 / OPTION 3 */

.wm-choice-card small {
  margin-top: 0 !important;

  color: rgba(147, 174, 244, .82) !important;
  opacity: 1 !important;

  font-size: 11px !important;
  font-weight: 850 !important;

  line-height: 1.35 !important;
  letter-spacing: .09em !important;
}


/* MAIN CHOICE TITLE */

.wm-choice-card > strong {
  margin-top: 18px !important;

  color: #f8faff !important;
  opacity: 1 !important;

  font-size: 21px !important;
  font-weight: 800 !important;

  line-height: 1.3 !important;
  letter-spacing: 0 !important;
}


/* DESCRIPTION */

.wm-choice-card > p {
  margin-top: 10px !important;

  max-width: 95%;

  color: rgba(235, 241, 255, .76) !important;
  opacity: 1 !important;

  font-size: 15px !important;
  font-weight: 500 !important;

  line-height: 1.6 !important;
}


/* CHOOSE → */

.wm-choice-card > b {
  margin-top: auto !important;

  padding-top: 22px !important;

  color: #ffc857 !important;
  opacity: 1 !important;

  font-size: 12px !important;
  font-weight: 900 !important;

  line-height: 1.3 !important;
  letter-spacing: .07em !important;
}


/* SELECTED STATE */

.wm-choice-card.selected > b {
  color: #ffc857 !important;
}


/* MOBILE */

@media (max-width: 720px) {

  .wm-choice-card {
    min-height: 190px !important;
    padding: 20px !important;
  }

  .wm-choice-card > strong {
    font-size: 19px !important;
  }

  .wm-choice-card > p {
    font-size: 14px !important;
  }

  .wm-choice-card small,
  .wm-choice-card > b {
    font-size: 11px !important;
  }
}



/* =========================================================
   WINGMATCH — LARGE GAME TEXT
   Final visual size pass
   ========================================================= */

.wm-choice-card {
  min-height: 235px !important;

  padding:
    27px 24px
    23px !important;
}


/* OPTION 1 */

.wm-choice-card > small,
.wm-choice-card small {
  color:
    rgba(154, 180, 247, .82)
    !important;

  opacity: 1 !important;

  font-size: 13px !important;
  font-weight: 850 !important;

  line-height: 1.3 !important;

  letter-spacing:
    .08em !important;
}


/* A science-value map */

.wm-choice-card > strong {
  margin-top: 20px !important;

  color: #ffffff !important;

  opacity: 1 !important;

  font-size: 27px !important;
  font-weight: 800 !important;

  line-height: 1.2 !important;

  letter-spacing:
    -.015em !important;
}


/*
 * See which site contains...
 */

.wm-choice-card > p {
  margin-top: 12px !important;

  color:
    rgba(240, 244, 255, .80)
    !important;

  opacity: 1 !important;

  font-size: 18px !important;
  font-weight: 500 !important;

  line-height: 1.5 !important;
}


/* CHOOSE → */

.wm-choice-card > b {
  margin-top: auto !important;

  padding-top: 25px !important;

  color: #ffc857 !important;

  opacity: 1 !important;

  font-size: 13px !important;
  font-weight: 900 !important;

  line-height: 1.3 !important;

  letter-spacing:
    .06em !important;
}


/* =========================================================
   QUESTION AREA
   ========================================================= */

.wm-question-kicker,
.wm-choice-kicker,
.wm-mission-question > span {
  font-size: 12px !important;
}


.wm-mission-question h2,
.wm-question h2 {
  color: #ffffff !important;

  font-size:
    clamp(
      34px,
      3vw,
      46px
    ) !important;

  line-height: 1.12 !important;
}


/* =========================================================
   GAME VISUAL MICROCOPY
   ========================================================= */

.wm-game-stage small,
.wm-game-stage span,
.wm-game-footer small,
.wm-game-footer span,
.wm-mission-visual small {
  font-size:
    max(
      11px,
      .6875rem
    ) !important;

  opacity: .82 !important;
}


/* "No aerospace knowledge is required." */

.wm-beginner-note,
.wm-mission-note {
  color:
    rgba(236, 241, 255, .72)
    !important;

  font-size: 13px !important;

  opacity: 1 !important;
}


/* Bottom disclaimer */

.wm-choice-disclaimer,
.wm-scoring-note {
  color:
    rgba(222, 230, 246, .62)
    !important;

  font-size: 12px !important;

  opacity: 1 !important;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 720px) {

  .wm-choice-card {
    min-height: 205px !important;

    padding: 22px !important;
  }

  .wm-choice-card > strong {
    font-size: 23px !important;
  }

  .wm-choice-card > p {
    font-size: 16px !important;
  }

  .wm-choice-card small,
  .wm-choice-card > b {
    font-size: 12px !important;
  }
}



/* =========================================================
   WINGMATCH V5 — NESTED CHOICE CONTENT
   Do NOT require elements to be direct children.
   ========================================================= */


/* OPTION 1 / OPTION 2 / OPTION 3 */

.wingmatch-shell .wm-choice-card small {
  color:
    rgba(160, 185, 248, .88)
    !important;

  opacity: 1 !important;

  font-size: 12px !important;
  font-weight: 850 !important;

  line-height: 1.35 !important;

  letter-spacing:
    .08em !important;
}


/* OPTION TITLE */

.wingmatch-shell .wm-choice-card strong {
  display: block !important;

  margin-top: 18px !important;

  color: #ffffff !important;

  opacity: 1 !important;

  font-size: 25px !important;
  font-weight: 800 !important;

  line-height: 1.25 !important;

  letter-spacing:
    -.015em !important;
}


/* OPTION DESCRIPTION */

.wingmatch-shell .wm-choice-card p {
  display: block !important;

  margin:
    11px 0 0 !important;

  color:
    rgba(241, 245, 255, .82)
    !important;

  opacity: 1 !important;

  font-size: 17px !important;
  font-weight: 500 !important;

  line-height: 1.55 !important;
}


/* CHOOSE → */

.wingmatch-shell .wm-choice-card b {
  color: #ffc857 !important;

  opacity: 1 !important;

  font-size: 12px !important;
  font-weight: 900 !important;

  line-height: 1.3 !important;

  letter-spacing:
    .06em !important;
}


/* Give the larger copy enough room */

.wingmatch-shell .wm-choice-card {
  min-height: 235px !important;

  padding:
    25px 22px
    22px !important;
}


/* Do the same even if V5 adds another wrapper */

.wingmatch-shell
.wm-choice-card
[class*="copy"] strong {
  font-size: 25px !important;
}

.wingmatch-shell
.wm-choice-card
[class*="copy"] p {
  color:
    rgba(241, 245, 255, .82)
    !important;

  font-size: 17px !important;

  line-height: 1.55 !important;
}


@media (max-width: 720px) {

  .wingmatch-shell
  .wm-choice-card strong {
    font-size: 22px !important;
  }

  .wingmatch-shell
  .wm-choice-card p {
    font-size: 16px !important;
  }
}

