import {
  useEffect,
  useMemo,
  useState,
} from "react";

import "./home-onboarding-tour.css";


interface Props {
  enabled: boolean;
}


interface TourStep {
  eyebrow: string;
  title: string;
  body: string;
  target: () => HTMLElement | null;
  scroll?: boolean;
}


function findControl(
  text: string,
) {

  const controls =
    Array.from(
      document.querySelectorAll<
        HTMLElement
      >(
        "button, a"
      ),
    );


  return (
    controls.find(
      element =>
        element.textContent
          ?.trim()
          .toLowerCase()
          .includes(
            text.toLowerCase(),
          ),
    ) ??
    null
  );
}


function findBuildCard(
  text: string,
) {

  const cards =
    Array.from(
      document.querySelectorAll<
        HTMLElement
      >(
        ".hlp-build-card"
      ),
    );


  return (
    cards.find(
      element =>
        element.textContent
          ?.toLowerCase()
          .includes(
            text.toLowerCase(),
          ),
    ) ??
    null
  );
}


export default function HomeOnboardingTour({
  enabled,
}: Props) {

  const [
    active,
    setActive,
  ] =
    useState(false);


  const [
    stepIndex,
    setStepIndex,
  ] =
    useState(0);


  const [
    rect,
    setRect,
  ] =
    useState<
      DOMRect | null
    >(
      null,
    );


  const steps =
    useMemo<TourStep[]>(
      () => [

        {
          eyebrow:
            "01 · YOUR WING",

          title:
            "This is a starting point — not a label.",

          body:
            "WingMatch gives you one direction worth testing. You are not locked into it.",

          target:
            () =>
              document.querySelector<HTMLElement>(
                ".hlp-current-wing",
              ),
        },


        {
          eyebrow:
            "02 · EXPLORE",

          title:
            "Now try another part of aerospace.",

          body:
            "Use Explore when you want to look beyond your WingMatch result and test other engineering fields.",

          target:
            () =>
              findControl(
                "Explore",
              ),
        },


        {
          eyebrow:
            "03 · TRY THE WORK",

          title:
            "Don't just read about GNC. Try it.",

          body:
            "Interactive Builds let you experience how different engineers think. Lost Sensor is the GNC Build.",

          target:
            () =>
              findBuildCard(
                "Lost Sensor",
              ),

          scroll:
            true,
        },


        {
          eyebrow:
            "04 · MY UNIVERSE",

          title:
            "This is where your work starts adding up.",

          body:
            "Your Wing, Builds, Proof of Flight, progress, and discoveries can live in My Universe.",

          target:
            () =>
              findControl(
                "My Universe",
              ),
        },

      ],
      [],
    );


  const step =
    steps[
      stepIndex
    ];


  function finish() {

    localStorage.setItem(
      "altwing-home-tour-v1",
      "complete",
    );

    setActive(
      false,
    );

    setStepIndex(
      0,
    );

    setRect(
      null,
    );
  }


  function updateTarget() {

    if (
      !active ||
      !step
    ) {
      return;
    }


    const element =
      step.target();


    if (!element) {

      setRect(
        null,
      );

      return;
    }


    if (
      step.scroll
    ) {

      element.scrollIntoView({
        behavior:
          "smooth",

        block:
          "center",
      });


      window.setTimeout(
        () => {

          setRect(
            element
              .getBoundingClientRect(),
          );

        },
        420,
      );

      return;
    }


    setRect(
      element
        .getBoundingClientRect(),
    );
  }


  useEffect(
    () => {

      if (!enabled) {
        return;
      }


      const alreadySeen =
        localStorage.getItem(
          "altwing-home-tour-v1",
        );


      if (
        alreadySeen !==
        "complete"
      ) {

        const timer =
          window.setTimeout(
            () => {

              setActive(
                true,
              );

            },
            650,
          );


        return () =>
          window.clearTimeout(
            timer,
          );
      }

    },
    [
      enabled,
    ],
  );


  useEffect(
    () => {

      if (!active) {
        return;
      }


      const timer =
        window.setTimeout(
          updateTarget,
          90,
        );


      const handleUpdate =
        () =>
          updateTarget();


      window.addEventListener(
        "resize",
        handleUpdate,
      );


      window.addEventListener(
        "scroll",
        handleUpdate,
        true,
      );


      return () => {

        window.clearTimeout(
          timer,
        );


        window.removeEventListener(
          "resize",
          handleUpdate,
        );


        window.removeEventListener(
          "scroll",
          handleUpdate,
          true,
        );
      };

    },
    [
      active,
      stepIndex,
    ],
  );


  function next() {

    if (
      stepIndex >=
      steps.length - 1
    ) {

      finish();

      return;
    }


    setRect(
      null,
    );


    setStepIndex(
      current =>
        current + 1,
    );
  }


  function previous() {

    setRect(
      null,
    );


    setStepIndex(
      current =>
        Math.max(
          0,
          current - 1,
        ),
    );
  }


  function replay() {

    setStepIndex(
      0,
    );

    setRect(
      null,
    );

    setActive(
      true,
    );
  }


  const tooltipStyle =
    rect
      ? {
          left:
            Math.max(
              16,
              Math.min(
                rect.left,
                window.innerWidth -
                  390,
              ),
            ),

          top:
            rect.bottom +
              18 >
            window.innerHeight -
              250
              ? Math.max(
                  16,
                  rect.top -
                    235,
                )
              : rect.bottom +
                18,
        }
      : undefined;


  return (
    <>

      {!active && enabled && (

        <button
          type="button"
          className="aw-guide-replay"
          onClick={
            replay
          }
        >
          ? GUIDE
        </button>

      )}


      {active && (

        <div className="aw-guide">

          <div className="aw-guide-dim" />


          {rect && (

            <>

              <div
                className="aw-guide-spotlight"
                style={{
                  left:
                    rect.left -
                    8,

                  top:
                    rect.top -
                    8,

                  width:
                    rect.width +
                    16,

                  height:
                    rect.height +
                    16,
                }}
              />


              <div
                className="aw-guide-pointer"
                style={{
                  left:
                    rect.left +
                    Math.min(
                      rect.width /
                        2,
                      rect.width -
                        18,
                    ),

                  top:
                    Math.max(
                      14,
                      rect.top -
                        42,
                    ),
                }}
              >
                ↓
              </div>

            </>

          )}


          <section
            className={[
              "aw-guide-card",

              rect
                ? ""
                : "is-centered",
            ]
              .filter(Boolean)
              .join(" ")}
            style={
              tooltipStyle
            }
          >

            <div className="aw-guide-progress">

              {steps.map(
                (
                  _,
                  index,
                ) => (

                  <span
                    key={
                      index
                    }
                    className={
                      index <=
                      stepIndex
                        ? "is-active"
                        : ""
                    }
                  />

                ),
              )}

            </div>


            <span className="aw-guide-eyebrow">
              {
                step.eyebrow
              }
            </span>


            <h3>
              {
                step.title
              }
            </h3>


            <p>
              {
                step.body
              }
            </p>


            <div className="aw-guide-actions">

              <button
                type="button"
                className="aw-guide-skip"
                onClick={
                  finish
                }
              >
                SKIP
              </button>


              <div>

                {stepIndex >
                  0 && (

                  <button
                    type="button"
                    className="aw-guide-back"
                    onClick={
                      previous
                    }
                  >
                    ← BACK
                  </button>

                )}


                <button
                  type="button"
                  className="aw-guide-next"
                  onClick={
                    next
                  }
                >
                  {stepIndex ===
                  steps.length -
                    1
                    ? "GOT IT ✓"
                    : "NEXT →"}
                </button>

              </div>

            </div>

          </section>

        </div>

      )}

    </>
  );
}
