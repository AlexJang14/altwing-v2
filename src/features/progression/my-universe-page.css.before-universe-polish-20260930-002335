.universe-page {
  min-height: 100vh;

  color: white;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(91,141,239,.12),
      transparent 28%
    ),
    #0d132b;
}

.universe-page-nav {
  height: 68px;

  display: grid;

  grid-template-columns:
    1fr auto 1fr;

  align-items: center;

  padding: 0 25px;

  border-bottom:
    1px solid
    rgba(255,255,255,.06);
}

.universe-page-nav button {
  width: fit-content;

  border: 0;

  color:
    rgba(255,255,255,.55);

  background: transparent;

  cursor: pointer;
}

.universe-page-nav button:last-child {
  justify-self: end;

  color: #ffc857;
}

.universe-page-nav strong {
  font-size: 18px;
}

.universe-page-nav strong span {
  color: #5b8def;
}

.universe-page-hero {
  width:
    min(
      900px,
      calc(100% - 32px)
    );

  margin:
    55px auto 25px;
}

.universe-page-hero > span {
  color: #5b8def;

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .18em;
}

.universe-page-hero h1 {
  margin:
    9px 0 12px;

  font-size:
    clamp(
      38px,
      7vw,
      68px
    );

  line-height: .96;

  letter-spacing: -.055em;
}

.universe-page-hero p {
  max-width: 540px;

  color:
    rgba(255,255,255,.48);

  line-height: 1.55;
}

.universe-page-content {
  width:
    min(
      900px,
      calc(100% - 32px)
    );

  margin:
    0 auto 70px;
}
