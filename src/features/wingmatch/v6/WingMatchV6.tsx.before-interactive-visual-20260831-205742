function shuffle<T>(
  items: T[],
): T[] {
  const copy =
    [...items];

  for (
    let i =
      copy.length - 1;
    i > 0;
    i -= 1
  ) {
    const j =
      Math.floor(
        Math.random() *
          (i + 1),
      );

    [
      copy[i],
      copy[j],
    ] = [
      copy[j],
      copy[i],
    ];
  }

  return copy;
}


function WingMatchV6({
  onExit,
}: WingMatchV6Props) {

  const [
    runNumber,
    setRunNumber,
  ] = useState(0);

  const [
    sceneIndex,
    setSceneIndex,
  ] = useState(0);

  const [
    selected,
    setSelected,
  ] =
    useState<WingOption | null>(
      null,
    );

  const [
    complete,
    setComplete,
  ] = useState(false);


  const scenes =
    useMemo(
      () =>
        SCENES.map(
          (scene) => ({
            ...scene,

            options:
              shuffle(
                scene.options,
              ),
          }),
        ),
      [runNumber],
    );


  const scene =
    scenes[sceneIndex];


  const progress =
    (
      (
        sceneIndex +
        (selected ? 1 : 0)
      ) /
      scenes.length
    ) *
    100;


  function choose(
    option: WingOption,
  ) {
    if (selected) {
      return;
    }

    setSelected(
      option,
    );
  }


  function next() {
    if (!selected) {
      return;
    }

    if (
      sceneIndex ===
      scenes.length - 1
    ) {
      setComplete(
        true,
      );

      return;
    }

    setSceneIndex(
      (current) =>
        current + 1,
    );

    setSelected(
      null,
    );

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }


  function restart() {
    setRunNumber(
      (current) =>
        current + 1,
    );

    setSceneIndex(
      0,
    );

    setSelected(
      null,
    );

    setComplete(
      false,
    );

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }


  if (complete) {
    return (
      <main className="aw6-shell">
        <header className="aw6-topbar">
          <button
            type="button"
            className="aw6-exit"
            onClick={onExit}
          >
            ← ALTWING
          </button>

          <div className="aw6-brand">
            Alt<span>Wing</span>
          </div>
        </header>

        <section className="aw6-complete">
          <img
            src="/brand/altwing-penguin.png"
            alt=""
          />

          <span className="aw6-kicker">
            WINGMATCH V6
          </span>

          <h1>
            Eight decisions.
            <br />
            One complete flight.
          </h1>

          <p>
            The new mission interface is
            working. Next we connect these
            decisions to the hidden Wing
            scoring engine and your existing
            result page.
          </p>

          <div className="aw6-complete-actions">
            <button
              type="button"
              onClick={restart}
            >
              REPLAY V6
            </button>

            <button
              type="button"
              onClick={onExit}
            >
              BACK TO ALTWING
            </button>
          </div>
        </section>
      </main>
    );
  }


  return (
    <main className="aw6-shell">

      <header className="aw6-topbar">

        <button
          type="button"
          className="aw6-exit"
          onClick={onExit}
        >
          ← EXIT
        </button>

        <div className="aw6-brand">
          Alt<span>Wing</span>
        </div>

        <div className="aw6-count">
          {String(
            sceneIndex + 1,
          ).padStart(
            2,
            "0",
          )}
          {" / "}
          {String(
            scenes.length,
          ).padStart(
            2,
            "0",
          )}
        </div>

      </header>


      <div className="aw6-progress">
        <span
          style={{
            width:
              `${progress}%`,
          }}
        />
      </div>


      <section className="aw6-stage">

        <div className="aw6-mission-meta">
          <span>
            {scene.eyebrow}
          </span>

          <b>
            {scene.phase}
          </b>
        </div>


        <p className="aw6-situation">
          {scene.situation}
        </p>


        <h1 className="aw6-question">
          {scene.question}
        </h1>


        <p className="aw6-instruction">
          There is no perfect answer.
          Choose the tradeoff you would
          actually accept.
        </p>


        <div className="aw6-options">

          {scene.options.map(
            (
              option,
              index,
            ) => {

              const isSelected =
                selected?.id ===
                option.id;

              return (
                <button
                  key={
                    option.id
                  }
                  type="button"
                  className={[
                    "aw6-option",

                    isSelected
                      ? "aw6-option--selected"
                      : "",

                    selected &&
                    !isSelected
                      ? "aw6-option--dimmed"
                      : "",
                  ]
                    .filter(
                      Boolean,
                    )
                    .join(
                      " ",
                    )}
                  disabled={
                    Boolean(
                      selected,
                    )
                  }
                  onClick={() =>
                    choose(
                      option,
                    )
                  }
                >

                  <span className="aw6-option-number">
                    OPTION{" "}
                    {index + 1}
                  </span>


                  <span className="aw6-option-title">
                    {
                      option.title
                    }
                  </span>


                  <span className="aw6-option-description">
                    {
                      option.description
                    }
                  </span>


                  <span className="aw6-option-action">
                    {isSelected
                      ? "SELECTED ✓"
                      : "CHOOSE →"}
                  </span>

                </button>
              );
            },
          )}

        </div>


        {selected && (
          <section className="aw6-consequence">

            <span>
              YOUR DECISION
            </span>

            <h2>
              {
                selected.title
              }
            </h2>

            <p>
              {
                selected.consequence
              }
            </p>

            <button
              type="button"
              onClick={next}
            >
              {sceneIndex ===
              scenes.length - 1
                ? "COMPLETE FLIGHT →"
                : "NEXT DECISION →"}
            </button>

          </section>
        )}

      </section>

    </main>
  );
}


export default WingMatchV6;
